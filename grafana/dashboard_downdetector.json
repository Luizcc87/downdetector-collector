    {
      "id": 30,
      "type": "table",
      "title": "Painel Downdetector",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "resultFormat": "time_series",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "zabbix"
          },
          "group": {
            "filter": "Downdetector"
          },
          "host": {
            "filter": "Downdetector"
          },
          "application": {
            "filter": ""
          },
          "item": {
            "filter": "/.*: (status|reports last hour|company id)$/"
          },
          "functions": []
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "Field",
            "format": "regex",
            "regExp": "^(?<Servico>[^:]+):\\s*(?<Metric>.+)$",
            "keepTime": false,
            "replace": false
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "Metric",
            "rowField": "Servico",
            "valueField": "Last *",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "company id": true
            },
            "indexByName": {
              "Servico\\Metric": 0,
              "status": 1,
              "reports last hour": 2
            },
            "renameByName": {
              "Servico\\Metric": "Serviço",
              "status": "Status",
              "reports last hour": "Relatos"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "frameIndex": 0,
        "sortBy": [
          {
            "displayName": "Status",
            "desc": true
          }
        ]
      },
      "pluginVersion": "11.6.0",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Ok 🟢",
                        "color": "#2EB85C",
                        "index": 0
                      },
                      "1": {
                        "text": "Atenção 🟠",
                        "color": "#F9B115",
                        "index": 1
                      },
                      "2": {
                        "text": "Problema 🔴",
                        "color": "#E55353",
                        "index": 2
                      },
                      "3": {
                        "text": "Desconhecido ⚪",
                        "color": "#9B59B6",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "custom.align",
                "value": "center"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Relatos"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 200
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#2EB85C",
                      "value": null
                    },
                    {
                      "color": "#F9B115",
                      "value": 50
                    },
                    {
                      "color": "#E55353",
                      "value": 100
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Serviço"
